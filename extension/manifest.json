{
  "manifest_version": 3,
  "name": "Offer History for Sleeper",
  "version": "1.0.0",
  "description": "See your past trade offers and their outcomes while you build a new one on Sleeper, and get warned before you send the same offer twice.",
  "minimum_chrome_version": "111",
  "icons": {
    "16": "icons/icon-16.png",
    "32": "icons/icon-32.png",
    "48": "icons/icon-48.png",
    "128": "icons/icon-128.png"
  },
  "permissions": ["storage", "unlimitedStorage"],
  "content_scripts": [
    {
      "matches": ["https://sleeper.com/*"],
      "js": ["inject.js"],
      "run_at": "document_start",
      "world": "MAIN"
    },
    {
      "matches": ["https://sleeper.com/*"],
      "js": ["content.js"],
      "run_at": "document_start"
    }
  ]
}
